# ─── Environment Variables ───────────────────────
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://jenanbiz:jenanbiz_pass@localhost:5432/jenanbiz

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# File uploads
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=./uploads

# Rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# CORS — comma-separated origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# WhatsApp Business API
WHATSAPP_API_URL=https://api.ultramsg.com/instanceXXXX
WHATSAPP_API_TOKEN=your_token_here
WHATSAPP_INSTANCE_ID=instanceXXXX
WHATSAPP_ENABLED=false

# App
APP_NAME=Jenan BIZ
DEBUG=true
LOG_LEVEL=INFO
