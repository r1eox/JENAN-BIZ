# ══════════════════════════════════════════════════════════════════
#  Jenan BIZ — Backend Production Environment
#  ⚠  Copy this file to backend/.env on the production server
#  ⚠  NEVER commit .env to version control
# ══════════════════════════════════════════════════════════════════

# ── Database ─────────────────────────────────────────────────────
# Replace with your actual PostgreSQL credentials
DATABASE_URL=postgresql+asyncpg://jenanbiz:CHANGE_DB_PASSWORD@db:5432/jenanbiz

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────────────────────────
# Generate a strong random key:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Security ─────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=WARNING
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://yourdomain.com

# ── Demo Seed ────────────────────────────────────────────────────
# Set to true only on FIRST deployment to create the initial owner account
# (phone: 0500000004 / password: password123) — CHANGE PASSWORD IMMEDIATELY after first login
# Set back to false after you've changed all passwords
SEED_DEMO_DATA=false

# ── File Uploads ─────────────────────────────────────────────────
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=/app/uploads

# ── WhatsApp Business API ────────────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_INSTANCE_ID=

# ── OpenAI ───────────────────────────────────────────────────────
OPENAI_ENABLED=true
OPENAI_API_KEY=sk-...your-key-here...
